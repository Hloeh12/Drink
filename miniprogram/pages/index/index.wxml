<view class="page-head">
  <view class="app-icon">💧</view>
  <view>
    <view class="app-name">打卡助手</view>
    <view class="sub">喝水 · 饮食 · 体重记录</view>
  </view>
</view>

<!-- 喝水打卡 -->
<view class="card">
  <view class="water-num">{{nowMl}}<text class="unit"> ml</text></view>
  <view class="sub center">目标 {{goal}} ml · 已完成 {{percent}}%</view>
  <view class="progress">
    <view class="progress-bar" style="width:{{percent}}%"></view>
  </view>

  <view class="cups">
    <view wx:for="{{cups}}" wx:key="*this" class="cup {{cup===item?'active':''}}" data-ml="{{item}}" bindtap="onCupTap">{{item}}ml</view>
  </view>

  <button class="big-btn" bindtap="onAdd">喝一杯 💧</button>
  <view class="mini-row">
    <button class="mini-btn" bindtap="onUndo">撤销一杯</button>
    <button class="mini-btn" bindtap="onReset">重置今日</button>
  </view>

  <view class="goal-row">
    <text class="sub">每日目标</text>
    <input type="number" class="goal-input" value="{{goal}}" bindblur="onGoalInput" />
    <text class="sub">ml</text>
  </view>
</view>

<!-- 饮食记录 -->
<view class="card">
  <view class="title">🍽️ 今日饮食记录</view>
  <view class="meal-row">
    <text class="tag">早餐</text>
    <textarea class="meal-input" value="{{meal.breakfast}}" data-field="breakfast" bindinput="onMealInput" placeholder="吃了什么…" />
  </view>
  <view class="meal-row">
    <text class="tag">午餐</text>
    <textarea class="meal-input" value="{{meal.lunch}}" data-field="lunch" bindinput="onMealInput" placeholder="吃了什么…" />
  </view>
  <view class="meal-row">
    <text class="tag">晚餐</text>
    <textarea class="meal-input" value="{{meal.dinner}}" data-field="dinner" bindinput="onMealInput" placeholder="吃了什么…" />
  </view>
  <view class="meal-row">
    <text class="tag">加餐</text>
    <textarea class="meal-input" value="{{meal.snack}}" data-field="snack" bindinput="onMealInput" placeholder="水果、零食、饮料…" />
  </view>
  <view class="weight-row">
    <text class="sub">晨起体重</text>
    <input type="digit" class="weight-input" value="{{meal.weight}}" bindinput="onWeightInput" placeholder="如 96.1" />
    <text class="sub">斤</text>
  </view>
</view>

<!-- 提醒设置 -->
<view class="card">
  <view class="set-row">
    <view>
      <view class="set-label">定时提醒</view>
      <view class="sub">小程序前台打开时按间隔提醒喝水</view>
    </view>
    <switch checked="{{remindOn}}" bindchange="onRemindChange" color="#2f9be0" />
  </view>
  <view class="set-row">
    <text class="set-label">提醒间隔</text>
    <view class="interval">每 <input type="number" class="interval-input" value="{{interval}}" bindblur="onIntervalInput" /> 分钟</view>
  </view>
</view>

<!-- 历史 -->
<view class="card">
  <view class="title">最近 7 天喝水</view>
  <view class="hist">
    <view class="col" wx:for="{{history}}" wx:key="label">
      <text class="val">{{item.val}}</text>
      <view class="bar {{item.today?'today':''}}" style="height:{{item.h}}%"></view>
      <text class="cap">{{item.label}}</text>
    </view>
  </view>
</view>

<view class="note">提示：少量多次饮用；饮食记录仅用于自我观察，注意均衡摄入，不要过度节食。如持续头晕、心慌、乏力，请及时进食休息，必要时就医。</view>
