.page-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.app-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #2f9be0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 38rpx;
  box-shadow: 0 8rpx 20rpx rgba(47, 155, 224, 0.3);
}
.app-name { font-size: 38rpx; font-weight: 700; }

/* 喝水 */
.water-num {
  text-align: center;
  font-size: 68rpx;
  font-weight: 800;
  color: #1b7cb8;
}
.water-num .unit { font-size: 26rpx; font-weight: 500; color: #6b8598; }
.center { text-align: center; margin: 8rpx 0 20rpx; }
.progress {
  height: 24rpx;
  background: #e3eef5;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}
.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #2f9be0, #7cc4ec);
  border-radius: 24rpx;
  transition: width 0.3s;
}

.cups { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.cup {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border: 1rpx solid #e3eef5;
  background: #f7fbfe;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #6b8598;
}
.cup.active { border-color: #2f9be0; background: #e8f4fc; color: #1b7cb8; font-weight: 600; }

.big-btn {
  background: #2f9be0;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 28rpx;
  padding: 26rpx 0;
  box-shadow: 0 12rpx 28rpx rgba(47, 155, 224, 0.3);
}
.big-btn::after { border: none; }

.mini-row { display: flex; gap: 20rpx; margin-top: 20rpx; }
.mini-btn {
  flex: 1;
  background: #fff;
  border: 1rpx solid #e3eef5;
  color: #6b8598;
  font-size: 28rpx;
  border-radius: 20rpx;
  padding: 20rpx 0;
}
.mini-btn::after { border: none; }

.goal-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  font-size: 28rpx;
}
.goal-input {
  width: 160rpx;
  padding: 14rpx 20rpx;
  border: 1rpx solid #e3eef5;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 饮食 */
.meal-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e3eef5;
}
.meal-row:last-of-type { border-bottom: none; }
.tag { flex: 0 0 80rpx; font-size: 26rpx; color: #6b8598; padding-top: 18rpx; }
.meal-input {
  flex: 1;
  border: 1rpx solid #e3eef5;
  background: #f7fbfe;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  height: 76rpx;
}
.weight-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  font-size: 28rpx;
}
.weight-input {
  flex: 1;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e3eef5;
  border-radius: 16rpx;
  font-size: 30rpx;
  background: #f7fbfe;
}

/* 提醒 */
.set-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e3eef5;
}
.set-row:last-child { border-bottom: none; }
.set-label { font-size: 30rpx; }
.interval { display: flex; align-items: center; gap: 12rpx; font-size: 28rpx; color: #6b8598; }
.interval-input {
  width: 120rpx;
  padding: 12rpx 0;
  border: 1rpx solid #e3eef5;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 历史 */
.hist { display: flex; align-items: flex-end; gap: 16rpx; height: 220rpx; margin-top: 20rpx; }
.col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 10rpx; height: 100%; justify-content: flex-end; }
.val { font-size: 22rpx; color: #1d3548; }
.bar {
  width: 100%;
  background: linear-gradient(180deg, #2f9be0, #7cc4ec);
  border-radius: 12rpx 12rpx 6rpx 6rpx;
  min-height: 8rpx;
}
.bar.today { background: #1b7cb8; }
.cap { font-size: 22rpx; color: #6b8598; }

.note { font-size: 24rpx; color: #6b8598; line-height: 1.7; margin-top: 10rpx; }
